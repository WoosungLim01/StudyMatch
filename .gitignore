__pycache__/
*.pyc
*.pyo
.DS_Store
*.egg-info/
.env
venv/
.venv/

# presentation decks - generated artifacts, not source
*.pptx

# Turso embedded-replica local cache (data/db.py) - rebuilt from the remote
# on every connect, never the source of truth, must never collide with the
# committed data/studymatch.db plain file
data/.turso_replica.db*

# Google OAuth client credentials downloaded from Cloud Console - real
# secrets (client ID + secret), configured on the host as GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET env vars instead, never committed
client_secret_*.json
